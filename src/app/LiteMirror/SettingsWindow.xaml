<ui:FluentWindow x:Class="LiteMirror.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="440" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,8,24,24">
            <TextBlock x:Name="NameLabel" />
            <ui:TextBox x:Name="NameBox" Margin="0,6,0,0" MaxLength="60" />

            <ui:ToggleSwitch x:Name="StartupSwitch" Margin="0,20,0,0" />
            <ui:ToggleSwitch x:Name="TopmostSwitch" Margin="0,12,0,0" />

            <TextBlock x:Name="LanguageLabel" Margin="0,20,0,0" />
            <ComboBox x:Name="LanguageBox" Margin="0,6,0,0" HorizontalAlignment="Left" MinWidth="200" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <ui:Button x:Name="CancelButton" MinWidth="90" Click="OnCancel" />
                <ui:Button x:Name="SaveButton" MinWidth="90" Margin="12,0,0,0" Appearance="Primary" Click="OnSave" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
