<ui:FluentWindow x:Class="LiteMirror.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Settings"
                 Width="440" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="Settings" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,8,24,24">
            <TextBlock x:Name="NameLabel" Text="Receiver name (shown on your iPhone)" />
            <ui:TextBox x:Name="NameBox" Margin="0,6,0,0" MaxLength="60" />

            <ui:ToggleSwitch x:Name="StartupSwitch" Margin="0,20,0,0" Content="Run when I sign in to Windows" />
            <ui:ToggleSwitch x:Name="TopmostSwitch" Margin="0,12,0,0" Content="Keep the window on top" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <ui:Button x:Name="CancelButton" Content="Cancel" MinWidth="90" Click="OnCancel" />
                <ui:Button x:Name="SaveButton" Content="Save" MinWidth="90" Margin="12,0,0,0" Appearance="Primary" Click="OnSave" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
