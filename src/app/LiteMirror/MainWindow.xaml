<hc:Window x:Class="LiteMirror.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:local="clr-namespace:LiteMirror"
           Title="LiteMirror" ShowTitle="False" ShowIcon="False"
           Width="960" Height="600" MinWidth="480" MinHeight="320"
           WindowStartupLocation="CenterScreen"
           NonClientAreaHeight="40"
           NonClientAreaBackground="{DynamicResource SecondaryRegionBrush}"
           Background="{DynamicResource SecondaryRegionBrush}"
           FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">

    <!-- title bar: pin on top; while a phone is connected also its name and the picture actions -->
    <hc:Window.NonClientAreaContent>
        <DockPanel LastChildFill="False" Margin="0,0,6,0">
            <ToggleButton x:Name="PinButton" DockPanel.Dock="Right" Style="{StaticResource ToggleButtonIconTransparent}"
                          hc:IconElement.Geometry="{StaticResource IconPin}" hc:IconElement.Width="14" hc:IconElement.Height="14"
                          Width="34" Height="30" VerticalAlignment="Center" Click="OnPin" />
            <StackPanel x:Name="Toolbar" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="DeviceLabel" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                <Button x:Name="FitButton" Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource IconFit}"
                        hc:IconElement.Width="15" hc:IconElement.Height="15" Width="34" Height="30" Click="OnFit" />
                <Button x:Name="FullButton" Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource IconFullscreen}"
                        hc:IconElement.Width="15" hc:IconElement.Height="15" Width="34" Height="30" Click="OnFullScreen" />
                <ToggleButton x:Name="InfoButton" Style="{StaticResource ToggleButtonIconTransparent}" hc:IconElement.Geometry="{StaticResource IconInfo}"
                              hc:IconElement.Width="15" hc:IconElement.Height="15" Width="34" Height="30" Click="OnInfo" />
                <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="6,0" />
            </StackPanel>
        </DockPanel>
    </hc:Window.NonClientAreaContent>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- sidebar: brand, pages, receiver state; shrinks to an icon rail while a phone is connected -->
        <Grid x:Name="Sidebar" Width="168" Margin="12,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="Brand" Orientation="Horizontal" Margin="12,2,0,14">
                <Border Width="26" Height="26" CornerRadius="5" Background="#2F7CF6">
                    <Path Data="{StaticResource IconLogo}" Fill="White" Stretch="Uniform" Margin="5.5" />
                </Border>
                <TextBlock FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0"
                           Visibility="{Binding NavText, RelativeSource={RelativeSource AncestorType=Window}}"><Run Text="Lite" /><Run Text="Mirror" Foreground="{DynamicResource PrimaryBrush}" /></TextBlock>
            </StackPanel>
            <StackPanel Grid.Row="1">
                <RadioButton x:Name="NavMirror" Style="{StaticResource NavItem}" Tag="{StaticResource IconMirror}" IsChecked="True" Checked="OnNav" />
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="{StaticResource IconSettings}" Checked="OnNav" />
                <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="{StaticResource IconInfo}" Checked="OnNav" />
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,0,0,2">
                <StackPanel Orientation="Horizontal" Margin="12,0,0,10">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Margin="9,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SecondaryTextBrush}" Visibility="{Binding NavText, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
                <Button x:Name="StartButton" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Stretch" Click="OnStartStop"
                        Visibility="{Binding NavText, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </Grid>

        <!-- pages -->
        <Grid x:Name="Pages" Grid.Column="1" Margin="12,0,12,12">
            <Border x:Name="MirrorPage" Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <StackPanel x:Name="Hint" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32" MaxWidth="460">
                        <TextBlock x:Name="HintTitle" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="HintBody" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock x:Name="ReceiverLabel" Margin="0,10,0,0" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" />
                        <Border x:Name="PinCard" Visibility="Collapsed" Margin="0,26,0,0" Padding="28,14" CornerRadius="8" HorizontalAlignment="Center"
                                Background="{DynamicResource LightPrimaryBrush}">
                            <StackPanel>
                                <TextBlock x:Name="PinTitle" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock x:Name="PinCode" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <local:VideoHost x:Name="Video" Visibility="Hidden" DoubleClick="OnVideoDoubleClick" />
                </Grid>
            </Border>

            <ContentControl x:Name="SettingsHost" Visibility="Collapsed" />

            <Border x:Name="AboutPage" Visibility="Collapsed" Style="{StaticResource Card}" Padding="28,24">
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="7" Background="#2F7CF6" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconLogo}" Fill="White" Stretch="Uniform" Margin="7.5" />
                        </Border>
                        <TextBlock FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"><Run Text="Lite" /><Run Text="Mirror" Foreground="{DynamicResource PrimaryBrush}" /></TextBlock>
                    </StackPanel>
                    <TextBlock x:Name="AboutVersion" Margin="0,4,0,8" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="UpdateButton" Click="OnCheckUpdate" />
                        <TextBlock x:Name="UpdateText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Button x:Name="DownloadButton" Margin="8,0,0,0" Visibility="Collapsed" Click="OnDownload" />
                    </StackPanel>
                    <TextBlock x:Name="AboutDesc" TextWrapping="Wrap" />
                    <TextBlock x:Name="AboutLicence" TextWrapping="Wrap" Margin="0,8,0,20" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SiteButton" hc:IconElement.Geometry="{StaticResource IconLink}" Click="OnSite" />
                        <Button x:Name="LogsButton" hc:IconElement.Geometry="{StaticResource IconFolder}" Margin="10,0,0,0" Click="OnOpenLogs" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Column="1" hc:Growl.GrowlParent="True" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,20,0" />
    </Grid>
</hc:Window>
