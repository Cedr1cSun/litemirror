<Project>

  <!-- keep obj/ next to the native build output instead of inside src/ -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>..\..\..\build\obj\LiteMirror\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>   <!-- NotifyIcon and Screen; both in-box on .NET Framework -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>LiteMirror</RootNamespace>
    <AssemblyName>LiteMirror</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <!-- same folder as litemirror.dll -->
    <OutputPath>..\..\..\build\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en;zh-CN</SatelliteResourceLanguages>
    <Version>0.0.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <Reference Include="System.Net.Http" />   <!-- in-box on .NET Framework; the update check -->
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
