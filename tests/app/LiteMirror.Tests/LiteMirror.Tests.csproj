<Project>

  <!-- keep obj/ next to the native build output instead of inside tests/ -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>..\..\..\build\obj\LiteMirror.Tests\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputPath>..\..\..\build\bin\$(Configuration)\LiteMirror.Tests\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- the pure logic under test is compiled in directly; the app exe is not referenced -->
    <Compile Include="..\..\..\src\app\LiteMirror\WindowShape.cs" Link="WindowShape.cs" />
    <Compile Include="..\..\..\src\app\LiteMirror\Settings.cs" Link="Settings.cs" />
    <Reference Include="WindowsBase" />   <!-- Rect and Size -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
